# Server Configuration
PORT=8787
NODE_ENV=development

# Database path (SQLite file, automatic directory creation & migrations)
DB_PATH=./data/xyrafin.db

# Optional LLM Configuration (OpenAI-compatible endpoint)
# If LLM_API_KEY is not provided, XyraFin runs in deterministic Offline Fallback Mode
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional Stellar Testnet Audit Anchor (defaults to false)
ANCHOR_ENABLED=false
STELLAR_SECRET_KEY=
